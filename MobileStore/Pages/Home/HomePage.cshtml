@page
@model EShope.Pages.Home.HomePage
@{
    Layout = "_Layout";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    body {
        direction: rtl;
        font-family: 'Vazirmatn', sans-serif;
        background: #f7f9fb;
    }

    .hero-img {
        height: 420px;
        object-fit: cover;
        border-radius: 12px;
    }

    .thumb-img {
        height: 80px;
        object-fit: cover;
        border-radius: 8px;
        cursor: pointer;
        border: 1px solid rgba(0,0,0,0.06);
    }

    .product-card {
        border-radius: 14px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 8px 20px rgba(16,24,40,0.04);
        transition: transform .18s;
    }

        .product-card:hover {
            transform: translateY(-6px);
        }

        .product-card .card-img-top {
            height: 200px;
            object-fit: contain;
            background: #f6f8f9;
            padding: 1rem;
        }

    .product-brand {
        color: #9aa6a7;
        font-size: .85rem;
        text-transform: lowercase;
    }

    .product-title {
        font-weight: 700;
        margin-top: .4rem;
        font-size: 1rem;
        color: #222;
    }

    .price {
        color: #0b8f73;
        font-weight: 700;
        font-size: 1.05rem;
    }

    .rating-stars {
        color: #f6b01e;
    }

    .cart-btn {
        height: 38px;
    }

    .save-btn.active {
        color: #e83e8c;
    }
</style>

<div class="container py-4">
    <!-- HERO / Carousel -->
    <div class="row mb-3">
        <div class="col-lg-9">
            <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @for (int i = 0; i < Model.Sliders.Count; i++)
                    {
                        var s = Model.Sliders[i];
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@(s.ImagePath ?? "/images/hero1.jpg")" class="d-block w-100 hero-img" alt="slide-@i" />
                        </div>
                    }
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">قبلی</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">بعدی</span>
                </button>
            </div>
        </div>

        <div class="col-lg-3 d-flex flex-column gap-2">
            @if (Model.Sliders != null && Model.Sliders.Count > 0)
            {
                @for (int i = 0; i < Model.Sliders.Count; i++)
                {
                    var thumb = Model.Sliders[i];
                    <img src="@(thumb.ImagePath ?? "/images/hero1.jpg")" class="thumb-img w-100" data-bs-target="#heroCarousel" data-bs-slide-to="@i" />
                }
            }
        </div>
    </div>

    <!-- Products header -->
    <div class="row align-items-center mb-3">
        <div class="col">
            <h4 class="mb-0">محصولات</h4>
            <div class="text-muted small">نمایش @Model.Products.Count محصول</div>
        </div>
    </div>

    <!-- Products grid -->
    <div class="row g-4">
        @foreach (var p in Model.Products)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card product-card h-100">
                    <img src="@(p.ImagePath ?? "/images/placeholder.png")" class="card-img-top" alt="@p.Name" />
                    <div class="card-body d-flex flex-column">
                        <div>
                            <div class="product-brand">@p.Brand @if(!string.IsNullOrWhiteSpace(p.ShopName)){
                            <span class="text-muted small"> • @p.ShopName</span>
                        }
</div>
                        <div class="product-title">@p.Name</div>
                        <p class="text-muted small mt-2">@p.ShortDescription</p>
                    </div>

                    <div class="mt-auto d-flex justify-content-between align-items-center">
                        <div>
                            <div class="rating-stars mb-1">
                                @{
                                    var stars = (int)Math.Round(p.AverageRating);
                                    for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= stars)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                            ;
                                        }
                                        else
                                        {

                                            <i class="bi bi-star"></i>
                                            ;
                                        }
                                    }
                                }
                            </div>
                            <div class="price">@string.Format(new System.Globalization.CultureInfo("fa-IR"), "{0:N0}", p.Price) تومان</div>
                        </div>

                        <div class="d-flex gap-2 align-items-center">
                            <button class="btn btn-sm btn-success cart-btn" onclick="addToCart('@p.Id','@p.Name')">
                                <i class="bi bi-cart-plus"></i>
                            </button>

                            <button class="btn btn-sm btn-outline-secondary save-btn" data-id="@p.Id" title="ذخیره">
                                <i class="bi bi-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
                }
    </div>

    <!-- Footer -->
    <footer class="mt-5 pt-4 border-top">
        <div class="row">
            <div class="col-md-6">
                <h6>درباره ما</h6>
                <p class="text-muted small">توضیح کوتاه درباره فروشگاه و شرایط ارسال و پشتیبانی.</p>
            </div>
            <div class="col-md-3">
                <h6>لینک‌ها</h6>
                <ul class="list-unstyled">
                    <li><a href="#">تماس با ما</a></li>
                    <li><a href="#">سوالات متداول</a></li>
                    <li><a href="#">حریم خصوصی</a></li>
                </ul>
            </div>
            <div class="col-md-3 text-md-end">
                <h6>شبکه‌های اجتماعی</h6>
                <div>
                    <i class="bi bi-instagram me-2"></i>
                    <i class="bi bi-telegram me-2"></i>
                    <i class="bi bi-youtube"></i>
                </div>
            </div>
        </div>

        <div class="text-center py-3 small text-muted">
            © @DateTime.Now.Year - تمامی حقوق محفوظ است.
        </div>
    </footer>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    const W_KEY = "eshop_wishlist_v1";

    function getWishlist() {
        try { return JSON.parse(localStorage.getItem(W_KEY) || "[]"); }
        catch { return []; }
    }
    function saveWishlist(arr) { localStorage.setItem(W_KEY, JSON.stringify(arr)); }

    function refreshSaveButtons() {
        const list = getWishlist();
        document.querySelectorAll('.save-btn').forEach(btn => {
            const id = btn.getAttribute('data-id');
            if (!id) return;
            if (list.includes(id)) {
                btn.classList.add('active');
                btn.innerHTML = '<i class="bi bi-heart-fill"></i>';
            } else {
                btn.classList.remove('active');
                btn.innerHTML = '<i class="bi bi-heart"></i>';
            }
        });
    }

    // handle wishlist click
    document.addEventListener('click', (e) => {
        const btn = e.target.closest('.save-btn');
        if (!btn) return;
        const id = btn.getAttribute('data-id');
        let list = getWishlist();
        if (list.includes(id)) list = list.filter(x => x !== id);
        else list.push(id);
        saveWishlist(list);
        refreshSaveButtons();
    });

    function addToCart(id, title) {
        // TODO: ارسال به API سبد خرید یا ذخیره محلی
        alert(`${title} به سبد اضافه شد.`);
    }

    // thumbnails -> carousel
    document.querySelectorAll('[data-bs-target="#heroCarousel"]').forEach((el) => {
        el.addEventListener('click', (ev) => {
            const idx = el.getAttribute('data-bs-slide-to');
            const carousel = bootstrap.Carousel.getOrCreateInstance(document.getElementById('heroCarousel'));
            carousel.to(Number(idx));
        });
    });

    // init
    refreshSaveButtons();
</script>