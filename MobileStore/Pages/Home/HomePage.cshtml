        <h5 class="mb-3">🌟 بهترین فروشگاه‌ها</h5>
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-6 g-4 justify-content-center">
            <!-- فروشگاه 1 -->
            <div class="col text-center">
                <a href="#" class="shop-circle">
                    <div class="circle-img mx-auto">
                        <i class="bi bi-shop"></i>
                    </div>
                    <span class="shop-name">دیجی‌کالا</span>
                </a>
            </div>
            <!-- فروشگاه 2 -->
            <div class="col text-center">
                <a href="#" class="shop-circle">
                    <div class="circle-img mx-auto">
                        <i class="bi bi-laptop"></i>
                    </div>
                    <span class="shop-name">تکنولایف</span>
                </a>
            </div>
            <!-- فروشگاه 3 -->
            <div class="col text-center">
                <a href="#" class="shop-circle">
                    <div class="circle-img mx-auto">
                        <i class="bi bi-gem"></i>
                    </div>
                    <span class="shop-name">زرین‌مد</span>
                </a>
            </div>
            <!-- فروشگاه 4 -->
            <div class="col text-center">
                <a href="#" class="shop-circle">
                    <div class="circle-img mx-auto">
                        <i class="bi bi-book"></i>
                    </div>
                    <span class="shop-name">بوک‌لند</span>
                </a>
            </div>
            <!-- فروشگاه 5 -->
            <div class="col text-center">
                <a href="#" class="shop-circle">
                    <div class="circle-img mx-auto">
                        <i class="bi bi-tsunami"></i>
                    </div>
                    <span class="shop-name">اسپرت‌شاپ</span>
                </a>
            </div>
            <!-- فروشگاه 6 -->
            <div class="col text-center">
                <a href="#" class="shop-circle">
                    <div class="circle-img mx-auto">
                        <i class="bi bi-cup-straw"></i>
                    </div>
                    <span class="shop-name">کافه‌بازار</span>
                </a>
            </div>
        </div>
    </div>

    <!-- ========= بخش چهار مستطیل ویژه (بالای محصولات) ========= -->
    <div class="my-5">
        <h5 class="mb-3">✨ پیشنهادات ویژه</h5>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="feature-rectangle">
                    <div class="feature-icon"><i class="bi bi-tags"></i></div>
                    <div class="feature-title">تخفیف شگفت‌انگیز</div>
                    <div class="feature-desc">تا ۵۰٪ تخفیف برای اولین خرید</div>
                    <a href="#" class="feature-link">مشاهده محصولات →</a>
                </div>
            </div>
            <div class="col-md-6">
                <div class="feature-rectangle">
                    <div class="feature-icon"><i class="bi bi-clock-history"></i></div>
                    <div class="feature-title">ارسال فوری</div>
                    <div class="feature-desc">تحویل درب منزل کمتر از ۲۴ ساعت</div>
                    <a href="#" class="feature-link">مشاهده محصولات →</a>
                </div>
            </div>
            <div class="col-md-6">
                <div class="feature-rectangle">
                    <div class="feature-icon"><i class="bi bi-gift"></i></div>
                    <div class="feature-title">هدیه ویژه</div>
                    <div class="feature-desc">به ازای هر خرید یک جایزه نقدی</div>
                    <a href="#" class="feature-link">مشاهده محصولات →</a>
                </div>
            </div>
            <div class="col-md-6">
                <div class="feature-rectangle">
                    <div class="feature-icon"><i class="bi bi-shield-check"></i></div>
                    <div class="feature-title">ضمانت اصالت</div>
                    <div class="feature-desc">بازگشت وجه تا ۷ روز</div>
                    <a href="#" class="feature-link">مشاهده محصولات →</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Products header -->
    <div class="row align-items-center mb-3">
        <div class="col">
            <h4 class="mb-0">محصولات</h4>
            <div class="text-muted small">نمایش @Model.Products.Count محصول</div>
        </div>
    </div>

    <!-- ========= Products grid با درج چهار مستطیل در وسط ========= -->
    @{
        int totalProducts = Model.Products.Count;
        int halfCount = (int)Math.Ceiling(totalProducts / 1.7);
        int currentIndex = 0;
    }

    <div class="row g-4">
        <!-- نیمه اول محصولات -->
        @foreach (var p in Model.Products)
        {
            if (currentIndex < halfCount)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card product-card h-100">
                        <img src="@(p.ImagePath ?? "/images/placeholder.jpg")" class="card-img-top" alt="@p.Name" />
                        <div class="card-body d-flex flex-column">
                            <div>
                                <div class="product-brand">
                                    @p.Brand
                                    @if (!string.IsNullOrWhiteSpace(p.ShopName))
                                    {
                                        <span class="text-muted small"> • @p.ShopName</span>
                                    }
                                </div>
                                <div class="product-title">@p.Name</div>
                                <p class="text-muted small mt-2">@p.ShopName</p>
                            </div>

                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="rating-stars mb-1">
                                        @{
                                            var stars = (int)Math.Round(p.AverageRating);
                                            for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= stars)
                                                {
                                                    <i class="bi bi-star-fill"></i>
                                                }
                                                else
                                                {

                                                    <i class="bi bi-star"></i>
                                                }
                                            }
                                        }
                                    </div>
                                    <div class="price">@string.Format(new System.Globalization.CultureInfo("fa-IR"), "{0:N0}", p.Price) تومان</div>
                                </div>

                                <div class="d-flex gap-2 align-items-center">
                                    <button class="btn btn-sm btn-success cart-btn" onclick="addToCart('@p.Id','@p.Name')">
                                        <i class="bi bi-cart-plus"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary save-btn" data-id="@p.Id" title="ذخیره">
                                        <i class="bi bi-bookmark"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            currentIndex++;
        }

        <!-- چهار مستطیل وسط صفحه (دو ردیف دو ستونه) -->
        <div class="row g-4 my-2 w-100 mx-0">
            <div class="col-md-6">
                <div class="feature-rectangle">
                    <div class="feature-icon"><i class="bi bi-lightning-charge"></i></div>
                    <div class="feature-title">پرفروش‌ترین‌ها</div>
                    <div class="feature-desc">محصولات داغ این هفته</div>
                    <a href="#" class="feature-link">مشاهده →</a>
                </div>
            </div>
            <div class="col-md-6">
                <div class="feature-rectangle">
                    <div class="feature-icon"><i class="bi bi-graph-up"></i></div>
                    <div class="feature-title">حراج ویژه</div>
                    <div class="feature-desc">تا ۷۰٪ تخفیف</div>
                    <a href="#" class="feature-link">مشاهده →</a>
                </div>
            </div>
            <div class="col-md-6">
                <div class="feature-rectangle">
                    <div class="feature-icon"><i class="bi bi-truck"></i></div>
                    <div class="feature-title">ارسال رایگان</div>
                    <div class="feature-desc">بالای ۵۰۰ هزار تومان</div>
                    <a href="#" class="feature-link">مشاهده →</a>
                </div>
            </div>
            <div class="col-md-6">
                <div class="feature-rectangle">
                    <div class="feature-icon"><i class="bi bi-emoji-smile"></i></div>
                    <div class="feature-title">خرید مطمئن</div>
                    <div class="feature-desc">بازگشت کالا تا ۳۰ روز</div>
                    <a href="#" class="feature-link">مشاهده →</a>
                </div>
            </div>
        </div>

        <!-- نیمه دوم محصولات -->
        @{
            currentIndex = 0;
            foreach (var p in Model.Products)
            {
                if (currentIndex >= halfCount)
                {
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        <div class="card product-card h-100">
                            <img src="@(p.ImagePath ?? "/images/placeholder.jpg")" class="card-img-top" alt="@p.Name" />
                            <div class="card-body d-flex flex-column">
                                <div>
                                    <div class="product-brand">
                                        @p.Brand
                                        @if (!string.IsNullOrWhiteSpace(p.ShopName))
                                        {
                                            <span class="text-muted small"> • @p.ShopName</span>
                                        }
                                    </div>
                                    <div class="product-title">@p.Name</div>
                                    <p class="text-muted small mt-2">@p.ShopName</p>
                                </div>

                                <div class="mt-auto d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="rating-stars mb-1">
                                            @{
                                                var stars = (int)Math.Round(p.AverageRating);
                                                for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= stars)
                                                    {
                                                        <i class="bi bi-star-fill"></i>
                                                    }
                                                    else
                                                    {

                                                        <i class="bi bi-star"></i>
                                                    }
                                                }
                                            }
                                        </div>
                                        <div class="price">@string.Format(new System.Globalization.CultureInfo("fa-IR"), "{0:N0}", p.Price) تومان</div>
                                    </div>

                                    <div class="d-flex gap-2 align-items-center">
                                        <button class="btn btn-sm btn-success cart-btn" onclick="addToCart('@p.Id','@p.Name')">
                                            <i class="bi bi-cart-plus"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary save-btn" data-id="@p.Id" title="ذخیره">
                                            <i class="bi bi-bookmark"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                currentIndex++;
            }
        }
    </div>

    <!-- Footer -->
    <footer class="mt-5 pt-4 border-top">
        <div class="row">
            <div class="col-md-6">
                <h6>درباره ما</h6>
                <p class="text-muted small">توضیح کوتاه درباره فروشگاه و شرایط ارسال و پشتیبانی.</p>
            </div>
            <div class="col-md-3">
                <h6>لینک‌ها</h6>
                <ul class="list-unstyled">
                    <li><a href="#">تماس با ما</a></li>
                    <li><a href="#">سوالات متداول</a></li>
                    <li><a href="#">حریم خصوصی</a></li>
                </ul>
            </div>
            <div class="col-md-3 text-md-end">
                <h6>شبکه‌های اجتماعی</h6>
                <div>
                    <i class="bi bi-instagram me-2 fs-4 text-dark"></i>
                    <i class="bi bi-telegram me-3 fs-4 text-info"></i>
                    <i class="bi bi-youtube me-3 fs-3 text-danger"></i>
                </div>
            </div>
        </div>
    </footer>

    <!-- مودال سبد خرید -->
    <div class="modal fade" id="cartModal" tabindex="-1" aria-labelledby="cartModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="cartModalLabel">🛒 سبد خرید</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <div class="modal-body" id="cartItemsContainer">
                    <!-- آیتم‌های سبد به‌صورت داینامیک در اینجا قرار می‌گیرند -->
                    <div class="text-center py-4 text-muted">در حال بارگذاری...</div>
                </div>
                <div class="modal-footer d-flex justify-content-between">
                    <button class="btn btn-danger" id="clearCartBtn">🗑 پاک کردن سبد</button>
                    <div>
                        <span class="fw-bold me-3" id="cartTotalPrice">جمع: ۰ تومان</span>
                        <button class="btn btn-success" id="checkoutBtn">پرداخت</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (User!.Identity!.IsAuthenticated)
    {
        <input type="hidden" id="loggedInUserId" value="@User.FindFirstValue(ClaimTypes.NameIdentifier)" />
    }
    else
    {
        <input type="hidden" id="loggedInUserId" value="" />
    }

</div>

<script>
    const W_KEY = "eshop_wishlist_v1";

    function getWishlist() {
        try { return JSON.parse(localStorage.getItem(W_KEY) || "[]"); }
        catch { return []; }
    }
    function saveWishlist(arr) { localStorage.setItem(W_KEY, JSON.stringify(arr)); }

    function refreshSaveButtons() {
        const list = getWishlist();
        document.querySelectorAll('.save-btn').forEach(btn => {
            const id = btn.getAttribute('data-id');
            if (!id) return;
            if (list.includes(id)) {
                btn.classList.add('active');
                btn.innerHTML = '<i class="bi bi-bookmark-fill"></i>';
            } else {
                btn.classList.remove('active');
                btn.innerHTML = '<i class="bi bi-bookmark"></i>';
            }
        });
    }

    document.addEventListener('click', (e) => {
        const btn = e.target.closest('.save-btn');
        if (!btn) return;
        const id = btn.getAttribute('data-id');
        let list = getWishlist();
        if (list.includes(id)) list = list.filter(x => x !== id);
        else list.push(id);
        saveWishlist(list);
        refreshSaveButtons();
    });

    function addToCart(id, title) {
        alert(`${title} به سبد اضافه شد.`);
    }

    document.addEventListener('DOMContentLoaded', function () {
        if (typeof bootstrap !== 'undefined') {
            document.querySelectorAll('[data-bs-target="#heroCarousel"]').forEach((el) => {
                el.addEventListener('click', (ev) => {
                    const idx = el.getAttribute('data-bs-slide-to');
                    const carousel = bootstrap.Carousel.getOrCreateInstance(document.getElementById('heroCarousel'));
                    carousel.to(Number(idx));
                });
            });
        }
    });

    refreshSaveButtons();
</script>

<script>
      // ==================== تنظیمات اولیه ====================
    const CART_API_BASE = '/api/Cart';

    // ==================== مدیریت CustomerId ====================
    function getCustomerId() {
        let cid = localStorage.getItem('customerId');
        if (!cid) {
            cid = crypto.randomUUID();
            localStorage.setItem('customerId', cid);
        }
        return cid;
    }

    const currentUserId = (() => {
        const loggedInUserId = document.getElementById('loggedInUserId')?.value;
        if (loggedInUserId && loggedInUserId !== '') {
            localStorage.setItem('customerId', loggedInUserId);
            return loggedInUserId;
        }
        return getCustomerId();
    })();

    // ==================== دریافت سبد خرید ====================
    async function fetchCart() {
        try {
            const res = await fetch(`${CART_API_BASE}?userId=${currentUserId}`);
            if (!res.ok) throw new Error('خطا در دریافت سبد');
            return await res.json(); // بازگشت مستقیم CartDto
        } catch (error) {
            console.error('fetchCart error:', error);
            return null;
        }
    }

    // ==================== نمایش سبد در مودال ====================
    async function renderCart() {
        const container = document.getElementById('cartItemsContainer');
        const totalPriceSpan = document.getElementById('cartTotalPrice');
        const badge = document.getElementById('cartBadge');

        const cartData = await fetchCart();
        // استفاده از Items (نه data) و بررسی count (نه quantity)
        if (!cartData || !cartData.items || cartData.items.length === 0) {
            container.innerHTML = `<div class="text-center py-4 text-muted">سبد خرید خالی است.</div>`;
            totalPriceSpan.innerText = 'جمع: ۰ تومان';
            badge.innerText = '0';
            return;
        }

        const items = cartData.items;
        let totalPrice = 0;
        let html = '<ul class="list-group list-group-flush">';

        items.forEach(item => {
            const price = item.price || 0;
            const count = item.count || 1;      // تغییر از quantity به count
            const total = price * count;
            totalPrice += total;

            html += `
                <li class="list-group-item d-flex justify-content-between align-items-center" data-product-id="${item.productId}">
                    <div class="d-flex align-items-center gap-3">
                        <img src="${item.imagePath || '/images/placeholder.jpg'}" alt="${item.productName}" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;">
                        <div>
                            <div class="fw-bold">${item.productName}</div>  <!-- استفاده از productName -->
                            <small class="text-muted">${item.brand || ''}</small>
                            <div class="text-success">${price.toLocaleString()} تومان</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-outline-secondary" onclick="changeQuantity('${item.productId}', -1)">−</button>
                        <span class="fw-bold" style="min-width: 30px; text-align: center;">${count}</span>
                        <button class="btn btn-sm btn-outline-secondary" onclick="changeQuantity('${item.productId}', 1)">+</button>
                        <button class="btn btn-sm btn-danger ms-2" onclick="removeFromCart('${item.productId}')">✕</button>
                    </div>
                </li>
            `;
        });

        html += '</ul>';
        container.innerHTML = html;
        totalPriceSpan.innerText = `جمع: ${totalPrice.toLocaleString()} تومان`;
        badge.innerText = items.reduce((sum, i) => sum + (i.count || 1), 0); // استفاده از count
    }

    // ==================== باز کردن مودال ====================
    async function openCartModal() {
        const modal = new bootstrap.Modal(document.getElementById('cartModal'));
        await renderCart();
        modal.show();
    }

    // ==================== افزودن به سبد خرید ====================
    async function addToCart(productId, productName) {
        try {
            const res = await fetch(CART_API_BASE, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    customerId: currentUserId,   // تغییر از userId به customerId
                    productId: productId,
                    count: 1                     // تغییر از quantity به count
                })
            });
            if (!res.ok) {
                // دریافت پیام خطا از سرور برای نمایش بهتر
                const errorText = await res.text();
                throw new Error(errorText || 'خطا در افزودن به سبد');
            }
            const result = await res.json();
            if (result.status !== 'Success') throw new Error(result.message || 'خطا');

            await updateCartBadge();
            const modalElement = document.getElementById('cartModal');
            if (modalElement.classList.contains('show')) {
                await renderCart();
            }
        } catch (error) {
            console.error('addToCart error:', error);
            alert(`افزودن به سبد با خطا مواجه شد: ${error.message}`);
        }
    }

    // ==================== تغییر تعداد ====================
    async function changeQuantity(productId, delta) {
        const cartData = await fetchCart();
        if (!cartData || !cartData.items) return;
        const item = cartData.items.find(i => i.productId === productId);
        if (!item) return;

        const newCount = (item.count || 1) + delta; // استفاده از count
        if (newCount <= 0) {
            await removeFromCart(productId);
            return;
        }

        try {
            const res = await fetch(CART_API_BASE, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    customerId: currentUserId,
                    productId: productId,
                    count: newCount
                })
            });
            if (!res.ok) throw new Error('خطا در به‌روزرسانی تعداد');
            const result = await res.json();
            if (result.status !== 'Success') throw new Error(result.message);

            await renderCart();
            await updateCartBadge();
        } catch (error) {
            console.error('changeQuantity error:', error);
            alert('تغییر تعداد با خطا مواجه شد.');
        }
    }

    // ==================== حذف از سبد ====================
    async function removeFromCart(productId) {
        try {
            const res = await fetch(`${CART_API_BASE}/${currentUserId}/${productId}`, {
                method: 'DELETE'
            });
            if (!res.ok) throw new Error('خطا در حذف از سبد');
            const result = await res.json();
            if (result.status !== 'Success') throw new Error(result.message);

            await renderCart();
            await updateCartBadge();
        } catch (error) {
            console.error('removeFromCart error:', error);
            alert('حذف از سبد با خطا مواجه شد.');
        }
    }

    // ==================== پاک کردن کل سبد ====================
    async function clearCart() {
        if (!confirm('آیا مطمئنید که کل سبد را پاک کنید؟')) return;
        try {
            const res = await fetch(`${CART_API_BASE}/clear?userId=${currentUserId}`, {
                method: 'DELETE'
            });
            if (!res.ok) throw new Error('خطا در پاک کردن سبد');
            const result = await res.json();
            if (result.status !== 'Success') throw new Error(result.message);

            await renderCart();
            await updateCartBadge();
        } catch (error) {
            console.error('clearCart error:', error);
            alert('پاک کردن سبد با خطا مواجه شد.');
        }
    }

    // ==================== به‌روزرسانی تعداد نشان‌دهنده سبد ====================
    async function updateCartBadge() {
        try {
            const res = await fetch(`${CART_API_BASE}/count?userId=${currentUserId}`);
            if (!res.ok) throw new Error('خطا در دریافت تعداد');
            const result = await res.json();
            if (result.status === 'Success' && result.data !== undefined) {
                document.getElementById('cartBadge').innerText = result.data;
            }
        } catch (error) {
            console.error('updateCartBadge error:', error);
        }
    }

    // ==================== اتصال رویدادها ====================
    document.addEventListener('DOMContentLoaded', function () {
        document.getElementById('clearCartBtn')?.addEventListener('click', clearCart);
        document.getElementById('checkoutBtn')?.addEventListener('click', function () {
            alert('در حال انتقال به درگاه پرداخت...');
        });
        updateCartBadge();
    });
</script>
