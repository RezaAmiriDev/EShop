@page
@model IndexModel
@{
    ViewData["Title"] = "مدیریت فروش‌ها";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    /* حداقل استایل‌های کمکی — بقیه با Bootstrap انجام می‌شود */
    .empty-state {
        text-align: center;
        padding: 2.5rem 0;
        color: #6c757d;
    }

        .empty-state svg {
            width: 72px;
            height: 72px;
            opacity: 0.6;
        }

    /* کارت‌های بالا */
    .top-cards .card {
        min-height: 120px;
    }

    /* Badge شبیه عکس: rounded, subtle bg, colored text */
    .payment-badge {
        display: inline-block;
        padding: .25rem .6rem;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 700;
        line-height: 1;
    }

    .payment-badge-success {
        background-color: rgba(34,197,94,0.12);
        color: #22c55e;
    }

    .payment-badge-fail {
        background-color: rgba(239,68,68,0.10);
        color: #ef4444;
    }

    .payment-badge-pending {
        background-color: rgba(250,204,21,0.12);
        color: #f59e0b;
    }

    /* dense table like screenshot */
    .table-sm tbody tr td {
        padding: .55rem .75rem;
    }

    .muted-small {
        color: #6c757d;
        font-size: .92rem;
    }
</style>

<div class="container py-4">
    <h2 class="mb-3">مدیریت فروش</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <!-- بالا: دو کارت کنار هم -->
    <div class="row top-cards gy-3 mb-4">
        <!-- مجموع فروش -->
        <div class="col-sm-6">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <div>
                        <h6 class="card-subtitle mb-2 text-muted">مجموع فروش‌ها</h6>
                        <h3 class="card-title display-6">@Model.TotalSales.ToString("N0")</h3>
                    </div>
                    <div class="mt-auto">
                        <button id="refreshTotalBtn" class="btn btn-outline-primary btn-sm">بروز رسانی</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- کارت دکمه‌ها / کنترل -->
        <div class="col-sm-6">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <div>
                        <h6 class="card-subtitle mb-1 text-muted">عملیات</h6>
                        <p class="mb-2 small text-muted">یک گزینه را انتخاب کنید؛ در صورت نیاز جستجو انجام شود.</p>
                    </div>

                    <div class="mb-2">
                        <div class="btn-group action-buttons" role="group" aria-label="actions">
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-action="recent">تراکنش‌های اخیر</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-action="customer">جستجو براساس مشتری</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-action="product">جستجو براساس محصول</button>
                        </div>
                    </div>

                    <div id="searchPanel" class="mt-auto d-none">
                        <div class="row g-2">
                            <div class="col-12 col-md-8">
                                <input id="searchInput" class="form-control form-control-sm" placeholder="شناسه (GUID) را وارد کنید" />
                            </div>
                            <div class="col-6 col-md-2">
                                <button id="doSearchBtn" class="btn btn-primary w-100 btn-sm">جستجو</button>
                            </div>
                            <div class="col-6 col-md-2">
                                <button id="clearSearchBtn" class="btn btn-outline-secondary w-100 btn-sm">پاک کردن</button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- پایین: لیست تراکنش‌ها تمام عرض -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 id="panelTitle" class="card-title mb-1">تراکنش‌های اخیر پرداخت</h5>

                        </div>
                        <div>
                            <button id="refreshPaymentsBtn" class="btn btn-outline-secondary btn-sm">بارگذاری مجدد</button>
                        </div>
                    </div>

                    <div id="panelBody">
                        <div id="paymentsContainer" class="table-responsive"></div>

                        <!-- pagination controls -->
                        <nav id="paymentsPagerNav" class="mt-3 d-none" aria-label="Payments pagination">
                            <ul id="paymentsPager" class="pagination justify-content-center mb-0"></ul>
                        </nav>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // server-side should set ViewData["ApiBase"] = client.BaseAddress (trim '/')
        window.__apiBase__ = '@(ViewData["ApiBase"] ?? "")';

        (function () {
            'use strict';

            const apiOrigin = (window.__apiBase__ && window.__apiBase__.length) ? window.__apiBase__ : window.location.origin;
            const apiOrderBase = `${apiOrigin}/api/order`;
            const apiPaymentsBase = `${apiOrigin}/api/order/payments`;

            // DOM
            const panelTitle = document.getElementById('panelTitle');
            const panelSubtitle = document.getElementById('panelSubtitle');
            const searchPanel = document.getElementById('searchPanel');
            const searchInput = document.getElementById('searchInput');
            const doSearchBtn = document.getElementById('doSearchBtn');
            const clearSearchBtn = document.getElementById('clearSearchBtn');
            const paymentsContainer = document.getElementById('paymentsContainer');
            const paymentsPagerNav = document.getElementById('paymentsPagerNav');
            const paymentsPager = document.getElementById('paymentsPager');
            const refreshPaymentsBtn = document.getElementById('refreshPaymentsBtn');
            const refreshTotalBtn = document.getElementById('refreshTotalBtn');

            let currentMode = 'recent';
            let currentPageSize = 12;
            let currentPage = 1;

            // helpers
            function showLoading(container) {
                container.innerHTML = `
                    <div class="d-flex justify-content-center align-items-center py-4">
                        <div class="spinner-border" role="status" aria-hidden="true"></div>
                        <span class="visually-hidden">Loading...</span>
                    </div>`;
            }
            function showEmpty(container, message = 'هیچ تراکنشی یافت نشد') {
                container.innerHTML = `
                    <div class="empty-state">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M3 3h18v4H3V3zM5 11h14v8H5v-8z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <div class="mt-3">${message}</div>
                    </div>`;
            }
            function showError(container, message) {
                container.innerHTML = `<div class="alert alert-danger">خطا: ${message}</div>`;
            }
            function escapeHtml(str) {
                if (str == null) return '';
                return String(str)
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#39;');
            }

            // status -> badge
            function statusBadge(statusStr) {
                const s = (statusStr ?? '').toString().toLowerCase();
                if (!s) return `<span class="payment-badge payment-badge-pending">نامشخص</span>`;
                if (s.includes('suc') || s.includes('paid')) return `<span class="payment-badge payment-badge-success">Paid</span>`;
                if (s.includes('fail') || s.includes('error')) return `<span class="payment-badge payment-badge-fail">Faild</span>`;
                if (s.includes('pend') || s.includes('redirect')) return `<span class="payment-badge payment-badge-pending">Wheting</span>`;
                if (s.includes('part') || s.includes('partial')) return `<span class="payment-badge payment-badge-pending">قسمتی</span>`;
                return `<span class="payment-badge payment-badge-pending">${escapeHtml(statusStr)}</span>`;
            }

            // build payments URL
            function paymentsUrl(page = 1, pageSize = currentPageSize) {
                const p = Math.max(1, parseInt(page || 1, 10));
                const s = Math.max(1, parseInt(pageSize || currentPageSize, 10));
                return `${apiPaymentsBase}?page=${p}&pageSize=${s}`;
            }

            // fetch and normalize payments (paged)
            async function fetchPayments(page = 1, pageSize = currentPageSize) {
                showLoading(paymentsContainer);
                paymentsPagerNav.classList.add('d-none');

                try {
                    const res = await fetch(paymentsUrl(page, pageSize), { credentials: 'same-origin' });
                    if (!res.ok) {
                        const txt = await res.text();
                        throw new Error(`${res.status} ${res.statusText} - ${txt}`);
                    }
                    const payload = await res.json();
                    console.log('payments payload:', payload);

                    // Normalize payload -> items array + paging
                    const dataPart = payload?.data ?? payload?.Data ?? payload;
                    let items = [];
                    let paging = null;

                    if (dataPart && (dataPart.Data || dataPart.data || dataPart.Items || dataPart.items)) {
                        items = dataPart.Data ?? dataPart.data ?? dataPart.Items ?? dataPart.items ?? [];
                        paging = {
                            pageNumber: dataPart.PageNumber ?? dataPart.pageNumber ?? 1,
                            totalPages: dataPart.TotalPages ?? dataPart.totalPages ?? 1,
                            totalRecords: dataPart.TotalRecords ?? dataPart.totalRecords ?? 0
                        };
                    } else if (Array.isArray(dataPart)) {
                        items = dataPart;
                    } else if (Array.isArray(payload?.data)) {
                        items = payload.data;
                    } else {
                        items = dataPart?.items ?? dataPart?.list ?? [];
                    }

                    if (!items || items.length === 0) {
                        const msg = payload?.message ?? payload?.Message ?? 'نتیجه‌ای وجود ندارد.';
                        showEmpty(paymentsContainer, msg);
                        return;
                    }

                    renderPayments(items, paging);
                } catch (err) {
                    console.error(err);
                    showError(paymentsContainer, err.message || 'خطا در دریافت تراکنش‌ها');
                }
            }

            // render payments table (Customer / Amount / Date / Status)
            function renderPayments(items, paging) {
                if (!Array.isArray(items) || items.length === 0) {
                    showEmpty(paymentsContainer, 'هیچ تراکنشی برای نمایش وجود ندارد.');
                    paymentsPagerNav.classList.add('d-none');
                    return;
                }

                const rows = items.map(p => {
                    const customer = p.customerName ?? p.customer ?? p.customerFullName ?? '';
                    const amount = (p.amount ?? p.Amount ?? 0);
                    const currency = p.currency ?? p.Currency ?? '';
                    const amountText = new Intl.NumberFormat('fa-IR').format(amount) + (currency ? ` ‎${escapeHtml(currency)}` : '');
                    const d = p.paymentDate ?? p.PaymentDate ?? p.createdAt ?? p.CreatedAt ?? null;
                    const dateText = d ? new Date(d).toLocaleDateString('fa-IR') : '';
                    const statusHtml = statusBadge(p.status ?? p.paymentStatus ?? p.Status ?? '');

                    const method = p.method ?? p.Method ?? p.provider ?? p.Provider ?? '';

                    return `
                        <tr>
                          <td class="align-middle">
                                <div class="fw-semibold">${escapeHtml(customer)}</div>
                                <div class="muted-small">${escapeHtml(method)}</div>
                            </td>
                            <td class="align-middle fw-bold">${escapeHtml(amountText)}</td>
                            <td class="align-middle">${escapeHtml(dateText)}</td>
                            <td class="align-middle">${statusHtml}</td>
                        </tr>
                    `;
                }).join('');

                 paymentsContainer.innerHTML = `
                <div class="table-responsive">
                <table class="table table-sm table-striped mb-0 align-middle text-center" style="table-layout: fixed; width:100%;">
                    <thead class="table-light">
                        <tr>
                            <th style="width:25%;">مشتری</th>
                            <th style="width:25%;">مبلغ</th>
                            <th style="width:25%;">تاریخ</th>
                            <th style="width:25%;">وضعیت</th>
                        </tr>
                    </thead>
                    <tbody>${rows}</tbody>
                </table>
            </div>
        `;

                if (paging && typeof paging.totalPages !== 'undefined') {
                    renderPager(paging.pageNumber || paging.PageNumber || 1, paging.totalPages || paging.TotalPages || 1);
                } else {
                    paymentsPagerNav.classList.add('d-none');
                }
            }

            // pager
            function renderPager(pageNumber, totalPages) {
                currentPage = pageNumber;
                if (totalPages <= 1) {
                    paymentsPagerNav.classList.add('d-none');
                    paymentsPager.innerHTML = '';
                    return;
                }

                paymentsPagerNav.classList.remove('d-none');

                const maxButtons = 5;
                let start = Math.max(1, pageNumber - 2);
                let end = Math.min(totalPages, pageNumber + 2);
                if (end - start < maxButtons - 1) {
                    if (start === 1) end = Math.min(totalPages, start + maxButtons - 1);
                    else if (end === totalPages) start = Math.max(1, end - maxButtons + 1);
                }

                let html = '';
                html += `<li class="page-item ${pageNumber === 1 ? 'disabled' : ''}"><button class="page-link" data-page="1" aria-label="First">«</button></li>`;
                html += `<li class="page-item ${pageNumber === 1 ? 'disabled' : ''}"><button class="page-link" data-page="${Math.max(1, pageNumber - 1)}" aria-label="Previous">‹</button></li>`;

                if (start > 1) html += `<li class="page-item disabled"><span class="page-link">…</span></li>`;

                for (let i = start; i <= end; i++) {
                    html += `<li class="page-item ${i === pageNumber ? 'active' : ''}"><button class="page-link" data-page="${i}">${i}</button></li>`;
                }

                if (end < totalPages) html += `<li class="page-item disabled"><span class="page-link">…</span></li>`;

                html += `<li class="page-item ${pageNumber === totalPages ? 'disabled' : ''}"><button class="page-link" data-page="${Math.min(totalPages, pageNumber + 1)}" aria-label="Next">›</button></li>`;
                html += `<li class="page-item ${pageNumber === totalPages ? 'disabled' : ''}"><button class="page-link" data-page="${totalPages}" aria-label="Last">»</button></li>`;

                paymentsPager.innerHTML = html;
            }

            // sales by customer/product (reuse table layout but different columns)
            async function loadSalesByCustomer(customerId) {
                showLoading(paymentsContainer);
                paymentsPagerNav.classList.add('d-none');
                try {
                    const res = await fetch(`${apiOrderBase}/customer/${encodeURIComponent(customerId)}`);
                    if (!res.ok) {
                        const txt = await res.text();
                        throw new Error(`${res.status} ${res.statusText} - ${txt}`);
                    }
                    const payload = await res.json();
                    const items = payload?.data ?? payload?.Data ?? [];
                    if (!Array.isArray(items) || items.length === 0) {
                        showEmpty(paymentsContainer, 'نتیجه‌ای یافت نشد.');
                        return;
                    }
                    renderSalesTable(items, 'customer');
                } catch (err) {
                    console.error(err);
                    showError(paymentsContainer, err.message || 'خطا در دریافت فروش‌ها بر اساس مشتری');
                }
            }

            async function loadSalesByProduct(productId) {
                showLoading(paymentsContainer);
                paymentsPagerNav.classList.add('d-none');
                try {
                    const res = await fetch(`${apiOrderBase}/product/${encodeURIComponent(productId)}`);
                    if (!res.ok) {
                        const txt = await res.text();
                        throw new Error(`${res.status} ${res.statusText} - ${txt}`);
                    }
                    const payload = await res.json();
                    const items = payload?.data ?? payload?.Data ?? [];
                    if (!Array.isArray(items) || items.length === 0) {
                        showEmpty(paymentsContainer, 'نتیجه‌ای یافت نشد.');
                        return;
                    }
                    renderSalesTable(items, 'product');
                } catch (err) {
                    console.error(err);
                    showError(paymentsContainer, err.message || 'خطا در دریافت فروش‌ها بر اساس محصول');
                }
            }

            function renderSalesTable(items, mode) {
                if (!Array.isArray(items) || items.length === 0) {
                    showEmpty(paymentsContainer, 'نتیجه‌ای یافت نشد.');
                    return;
                }

                const rows = items.map(s => {
                    const secondCol = mode === 'customer' ? (s.productName ?? s.productNameSnapshot ?? '') : (s.customerName ?? '');
                    const total = s.totalPrice ?? s.TotalPrice ?? 0;
                    const totalText = new Intl.NumberFormat('fa-IR').format(total) + (s.currency ? ` ‎${escapeHtml(s.currency)}` : '');
                    const dateText = s.saleDate ? new Date(s.saleDate).toLocaleDateString('fa-IR') : '';
                    const statusHtml = statusBadge(s.paymentStatus ?? s.PaymentStatus ?? s.status ?? s.Status ?? '');

                    return `
                        <tr>
                            <td class="align-middle">${escapeHtml(secondCol)}</td>
                            <td class="align-middle text-end fw-semibold">${escapeHtml(totalText)}</td>
                            <td class="align-middle">${statusHtml}</td>
                            <td class="align-middle">${escapeHtml(dateText)}</td>
                        </tr>
                    `;
                }).join('');

                paymentsContainer.innerHTML = `
                    <div class="table-responsive">
                        <table class="table table-sm table-striped mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>${mode === 'customer' ? 'محصول' : 'مشتری'}</th>
                                    <th class="text-end">قیمت کل</th>
                                    <th>وضعیت</th>
                                    <th>تاریخ فروش</th>
                                </tr>
                            </thead>
                            <tbody>${rows}</tbody>
                        </table>
                    </div>
                `;
            }

            // wire header buttons
            document.querySelectorAll('.action-buttons [data-action]').forEach(btn => {
                btn.addEventListener('click', () => {
                    const action = btn.dataset.action;
                    setMode(action);
                });
            });

            // pager click delegation
            paymentsPager.addEventListener('click', (e) => {
                const btn = e.target.closest('button[data-page]');
                if (!btn) return;
                const page = parseInt(btn.getAttribute('data-page'), 10) || 1;
                fetchPayments(page, currentPageSize);
            });

            // search button and enter key
            doSearchBtn.addEventListener('click', () => {
                const val = searchInput.value.trim();
                if (!val) return alert('لطفاً مقدار را وارد کنید.');
                if (currentMode === 'customer') loadSalesByCustomer(val);
                else if (currentMode === 'product') loadSalesByProduct(val);
            });
            searchInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') doSearchBtn.click();
            });

            clearSearchBtn.addEventListener('click', () => {
                searchInput.value = '';
                if (currentMode === 'recent') fetchPayments(1, currentPageSize);
                else paymentsContainer.innerHTML = '';
            });

            refreshPaymentsBtn.addEventListener('click', () => fetchPayments(1, currentPageSize));
            refreshTotalBtn.addEventListener('click', () => location.reload());

            function setMode(mode) {
                currentMode = mode;
                searchInput.value = '';
                paymentsContainer.innerHTML = '';
                paymentsPagerNav.classList.add('d-none');

                if (mode === 'recent') {
                    panelTitle.textContent = 'تراکنش‌های اخیر پرداخت';
                    panelSubtitle.textContent = 'نمایش تراکنش‌های موفق، ناموفق و در انتظار';
                    searchPanel.classList.add('d-none');
                    fetchPayments(1, currentPageSize);
                } else if (mode === 'customer') {
                    panelTitle.textContent = 'جستجوی فروش بر اساس مشتری';
                    panelSubtitle.textContent = 'شناسه مشتری (GUID) را وارد کنید و جستجو را بزنید';
                    searchInput.placeholder = 'CustomerId (GUID)';
                    searchPanel.classList.remove('d-none');
                    paymentsContainer.innerHTML = `<div class="text-muted">شناسه مشتری را وارد و دکمه جستجو را بزنید.</div>`;
                } else if (mode === 'product') {
                    panelTitle.textContent = 'جستجوی فروش بر اساس محصول';
                    panelSubtitle.textContent = 'شناسه محصول (GUID) را وارد کنید و جستجو را بزنید';
                    searchInput.placeholder = 'ProductId (GUID)';
                    searchPanel.classList.remove('d-none');
                    paymentsContainer.innerHTML = `<div class="text-muted">شناسه محصول را وارد و دکمه جستجو را بزنید.</div>`;
                }
            }

            // initialize
            setMode('recent');

        })();
    </script>
}
