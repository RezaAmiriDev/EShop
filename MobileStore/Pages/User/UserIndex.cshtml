@page
@model EShope.Pages.User.UserIndexModel
@{
    ViewData["Title"] = "مدیریت کاربران";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>User Manager</h2>
        <a asp-page="CreateUser" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> ایجاد کاربر جدید
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Users.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>نام کاربری</th>
                        <th>ایمیل</th>
                        <th>نقش</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.UserName</td>
                            <td>@user.Email</td>
                            <td>
                                <span class="badge bg-primary">@user.Role</span>
                            </td>
                            <td>
                                <a asp-page="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil"></i> ویرایش
                                </a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id"
                                      style="display:inline;" onsubmit="return confirm('آیا از حذف کاربر @user.UserName مطمئن هستید؟');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> حذف
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle"></i> هیچ کاربری یافت نشد.
        </div>
    }
</div>