<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - MobileStore</title>
    <!-- کتابخانه‌های CSS محلی -->
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/boxicons/css/boxicons.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <!-- فایل‌های CSS شخصی (بعد از کتابخانه‌ها) -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css' rel='stylesheet'> *@

</head>
<body>
    <div class="container">
        <nav class="sidebar close">
            <header>
                <div class="image-text">
                    <span class="image">
                        <img src="~/Images/pngegg.png" alt="">
                    </span>
                    <div class="text logo-text">
                        <span class="name">@ViewBag.Username</span>
                        <span class="profession">Web developer</span>
                    </div>
                </div>
                <i class='bx bx-chevron-right toggle'></i>
            </header>
            <div class="menu-bar">
                <div class="menu">
                    <ul style="list-style:none ; margin:0 ; padding: 0;">
                        <li class="search-box">
                            <a href="/Home/HomePage">
                                <i class='bx bx-globe icon'></i>
                                <span class="text nav-text">Web Site</span>
                            </a>
                        </li>

                        <li class="search-box">
                            <a href="/SliderImage/Index">
                                <i class='bx bx-slider-alt icon'></i>
                                <span class="text nav-text">Dashboard</span>
                            </a>
                        </li>

                        <li class="search-box">
                            <a href="/Dashboard/Index">
                                <i class='bx bx-bar-chart-alt-2 icon'></i>
                                <span class="text nav-text">Revenue</span>
                            </a>
                        </li>

                        <li class="search-box">
                            <a href="/Customer/Index">
                                <i class='bx bx-user icon'></i>
                                <span class="text nav-text">Customer</span>
                            </a>
                        </li>

                        <li class="search-box">
                            <a href="/Order/Index">
                                <i class='bx bx-pie-chart-alt icon'></i>
                                <span class="text nav-text">Analytics</span>
                            </a>
                        </li>

                        <li class="search-box">
                            <a href="/Shop/Index">
                                <i class='bx bx-store icon'></i>
                                <span class="text nav-text">Shops</span>
                            </a>
                        </li>

                        <li class="search-box">
                            <a href="/Product/Index">
                                <i class='bx bx-wallet icon'></i>
                                <span class="text nav-text">Product</span>
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="bottom-content">
                    <ul style="list-style:none ; margin:0 ; padding:0">
                       <li class="mode">

                         <div class="sun-moon">
                           <i class='bx bx-moon icon moon'></i>
                           <i class='bx bx-sun icon sun'></i>
                         </div>

                         <span class="mode-text text">Dark mode</span>
                         <div class="toggle-switch">
                           <span class="switch"></span>
                         </div>
                       </li>
                    </ul>
                </div>
            </div>
        </nav>
    </div>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="container text-center">
            &copy; 2024 - amiri_Production - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- کتابخانه‌های JS محلی (ترتیب مهم است) -->
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/chart.js/chart.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        const body = document.querySelector('body'),
            sidebar = body.querySelector('nav'),
            toggle = body.querySelector(".toggle"),
            searchBtn = body.querySelector(".search-box"),
            modeSwitch = body.querySelector(".toggle-switch"),
            modeText = body.querySelector(".mode-text");
        toggle.addEventListener("click", () => {
            sidebar.classList.toggle("close");
        })
        searchBtn.addEventListener("click", () => {
            sidebar.classList.remove("close");
        })
        modeSwitch.addEventListener("click", () => {
            body.classList.toggle("dark");
            if (body.classList.contains("dark")) {
                modeText.innerText = "Light mode";
            } else {
                modeText.innerText = "Dark mode";
            }
        });
    </script>

    <script>
        $(function () {
            // این کد فقط در صورتی کار می‌کند که jQuery قبلاً لود شده باشد
            $("#ClickSearch").click(function () {
                $.ajax({
                    url: '@Url.Action("Index", "Customer")',
                    type: "GET",
                    data: {
                        name: $('#SearchByCode').val()
                    },
                    success: function (result) {
                        // در اینجا باید selector مناسب قرار دهید
                        // $('#targetElement').html(result);
                    },
                    error: function () {
                        alert("خطا در جستجو");
                    }
                });
            });
        });

        $(document).on('click', '.edit-button', function () {
            var recordId = $(this).data('id');
            $.ajax({
                url: '/Customer/Details/' + recordId,
                type: 'GET',
                success: function (response) {
                    $('#modalEditContent').html(response);
                },
                error: function () {
                    alert("خطا در بارگذاری اطلاعات");
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>