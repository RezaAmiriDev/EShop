@page
@model EShope.Pages.Product.IndexModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery


@{
    ViewData["Title"] = "Products";
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
}

@if (ViewData["ApiError"] != null)
{
    <div class="alert alert-danger my-2">
        <strong>API Error:</strong> @ViewData["ApiError"]
    </div>
}
<div class="mb-2">
    <small class="text-muted">
        API Base: @ViewData["ApiBase"] |
        StatusCode: @ViewData["ApiStatusCode"] |
        Items: @ViewData["Count"]
    </small>
</div>

<div class="row align-items-center px-4 m-2">
    <div class="col-md-6 d-flex align-items-center">
        <h1 class="mb-0 me-5">Products</h1>
    </div>

    <div class="col-md-6">
        <form id="searchForm" class="d-flex align-items-center" onsubmit="return false;">
            <input type="text" id="searchInput" name="name" class="form-control form-control-md me-2"
                   placeholder="Search by Product Name" value="@(Model.SearchTerm ?? "")">
            <button id="searchBtn" class="btn btn-success btn-md me-2">Search</button>
            <a asp-page="/Product/Create" class="btn btn-info btn-md text-light d-flex align-items-center">
                <i class="bi bi-plus-circle me-1"></i> Add
            </a>
        </form>
    </div>
</div>

<!-- نتایج -->
<div class="container mt-4" id="productResults">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4" id="productGrid">
        @foreach (var product in Model.proDto)
        {
            <div class="col product-card" data-id="@product.Id">
                <div class="card h-100">
                    <img src="@(string.IsNullOrEmpty(product.ImagePath) ? "/Images/default.png" : product.ImagePath)"
                         class="card-img-top" alt="Product Image"
                         onerror="this.src='/Images/default.png'">
                    <div class="card-body">
                        <h5 class="card-title">Brand: @product.Brand</h5>
                        <p class="card-text">Type: @product.Type</p>
                        <p class="card-text">Price: @product.Price</p>
                    </div>
                    <div class="card-footer d-flex justify-content-between">
                        <a asp-page="/Product/Edit" asp-route-id="@product.Id" class="btn btn-primary btn-sm">Edit</a>
                        <button class="btn btn-danger btn-sm delete-product" data-id="@product.Id">Remove</button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- صفحه‌بندی -->
    <div id="paginationContainer" class="d-flex justify-content-between align-items-center mt-4 @(Model.TotalPages <= 1 ? "d-none" : "")">
        <nav aria-label="Product pagination">
            <ul id="pagination" class="pagination justify-content-center mb-0">
                <!-- توسط جاوااسکریپت پر می‌شود -->
            </ul>
        </nav>
        <div id="pageInfo" class="text-muted">
            Page <span id="currentPage">@Model.PageNumber</span> of <span id="totalPages">@Model.TotalPages</span>
        </div>
    </div>
</div>

<!-- توکن برای حذف -->
<input type="hidden" id="__RequestVerificationToken" value="@antiforgeryToken" />
<input type="hidden" id="apiBaseUrl" value="@ViewData["ApiBase"]" />


@section Scripts {
    <script>
        (function () {
            'use strict';

            // ---------- config ----------
            const apiBaseUrl = '@ViewData["ApiBase"]' || '';
            const apiUrl = apiBaseUrl ? `${apiBaseUrl}/api/Product/paged` : '/api/Product/paged';
            console.log('API URL:', apiUrl);

            let state = {
                pageNumber: @Model.PageNumber,
                pageSize: @Model.PageSize,
                totalRecords: @Model.TotalCount,
                totalPages: @Model.TotalPages,
                searchTerm: '@Html.Raw(Model.SearchTerm ?? "")'
            };

            // درخواست فعلی و کنترل‌کننده برای ابورت کردن
            let currentController = null;
            let currentRequestId = 0;

            // --- آماده‌سازی overlay لودینگ (یک‌بار) ---
            const grid = document.getElementById('productGrid');
            const gridWrapper = grid.parentElement || document.body;
            const loadingOverlay = document.createElement('div');
            loadingOverlay.className = 'product-grid-loading d-none';
            loadingOverlay.style.position = 'absolute';
            loadingOverlay.style.inset = '0';
            loadingOverlay.style.display = 'flex';
            loadingOverlay.style.alignItems = 'center';
            loadingOverlay.style.justifyContent = 'center';
            loadingOverlay.style.background = 'rgba(255,255,255,0.6)';
            loadingOverlay.style.zIndex = '1000';
            loadingOverlay.innerHTML = `
                <div class="text-center">
                    <div class="spinner-border" role="status" style="width:3rem;height:3rem">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="mt-2">Loading products...</div>
                </div>`;
            // برای اینکه overlay اندازهٔ کانتینر را بگیرد، wrapper باید position: relative داشته باشد
            if (getComputedStyle(gridWrapper).position === 'static') {
                gridWrapper.style.position = 'relative';
            }
            gridWrapper.appendChild(loadingOverlay);

            function showLoading() {
                loadingOverlay.classList.remove('d-none');
                disablePagination();
            }
            function hideLoading() {
                loadingOverlay.classList.add('d-none');
                enablePagination();
            }

            function disablePagination() {
                document.querySelectorAll('.page-link').forEach(link => {
                    link.classList.add('disabled');
                    link.setAttribute('aria-disabled', 'true');
                });
            }
            function enablePagination() {
                document.querySelectorAll('.page-link').forEach(link => {
                    link.classList.remove('disabled');
                    link.removeAttribute('aria-disabled');
                });
            }

            // ساخت درخواست
            function buildRequest(pageNumber) {
                const searchInput = document.getElementById('searchInput');
                const searchTerm = searchInput ? searchInput.value.trim() : (state.searchTerm || '');

                return {
                    PageNumber: pageNumber,
                    PageSize: state.pageSize,
                    StartIndex: (pageNumber - 1) * state.pageSize,
                    Data: {
                        Brand: searchTerm || null,
                        ProductCode: null
                    }
                };
            }

            // ثابت کردن ابعاد کارت/عکس برای جلوگیری از لرزش (اگر CSS ندارید این را هم می‌توانید داخل صفحه قرار دهید)
            const extraStyle = document.createElement('style');
            extraStyle.innerHTML = `
                .product-card .card { min-height: 340px; }
                .product-card img { width:100%; height:180px; object-fit:cover; display:block; }
            `;
            document.head.appendChild(extraStyle);

            // رندر محصولات
            function renderProducts(items) {
                if (!Array.isArray(items) || items.length === 0) {
                    grid.innerHTML = `
                        <div class="col-12">
                            <div class="alert alert-info text-center py-4">
                                <i class="bi bi-search me-2"></i>
                                No products found.
                            </div>
                        </div>`;
                    return;
                }

                const html = items.map(product => {
                    const id = product.id ?? product.Id ?? '';
                    const brand = product.brand ?? product.Brand ?? '';
                    const type = product.type ?? product.Type ?? '';
                    const price = product.price ?? product.Price ?? '';
                    const imagePath = product.imagePath ?? product.ImagePath ?? '/Images/default.png';
                    const formattedPrice = price !== undefined && price !== null && price !== '' ? parseFloat(price).toFixed(2) : '0.00';

                    // اضافه کردن attributes width/height و انطباق برای ثبات layout
                    return `
                    <div class="col product-card" data-id="${id}">
                        <div class="card h-100">
                            <img src="${imagePath}" alt="${brand}" onerror="this.src='/Images/default.png'">
                            <div class="card-body">
                                <h5 class="card-title">${brand}</h5>
                                <p class="card-text">Type: ${type}</p>
                                <p class="card-text">Price: $${formattedPrice}</p>
                            </div>
                            <div class="card-footer d-flex justify-content-between">
                                <a href="/Product/Edit/${id}" class="btn btn-primary btn-sm">Edit</a>
                                <button class="btn btn-danger btn-sm delete-product" data-id="${id}">Remove</button>
                            </div>
                        </div>
                    </div>`;
                }).join('');

                grid.innerHTML = html;
            }

            // رندر صفحه‌بندی بدون onclick inline — از data-page استفاده می‌کنیم
            function renderPagination() {
                const container = document.getElementById('paginationContainer');
                const current = state.pageNumber;
                const totalPages = state.totalPages;

                if (!container || totalPages <= 1) {
                    container && container.classList.add('d-none');
                    return;
                }

                container.classList.remove('d-none');
                document.getElementById('currentPage').textContent = current;
                document.getElementById('totalPages').textContent = totalPages;

                let startPage = Math.max(1, current - 2);
                let endPage = Math.min(totalPages, current + 2);

                if (endPage - startPage < 4) {
                    if (startPage === 1) {
                        endPage = Math.min(totalPages, startPage + 4);
                    } else if (endPage === totalPages) {
                        startPage = Math.max(1, endPage - 4);
                    }
                }

                let paginationHtml = `
                    <li class="page-item ${current === 1 ? 'disabled' : ''}">
                        <a class="page-link" href="#" data-page="1" aria-label="First"><span aria-hidden="true">«</span></a>
                    </li>
                    <li class="page-item ${current === 1 ? 'disabled' : ''}">
                        <a class="page-link" href="#" data-page="${Math.max(1, current-1)}" aria-label="Previous"><span aria-hidden="true">‹</span></a>
                    </li>`;

                if (startPage > 1) {
                    paginationHtml += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
                }

                for (let i = startPage; i <= endPage; i++) {
                    paginationHtml += `
                        <li class="page-item ${i === current ? 'active' : ''}">
                            <a class="page-link" href="#" data-page="${i}">${i}</a>
                        </li>`;
                }

                if (endPage < totalPages) {
                    paginationHtml += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
                }

                paginationHtml += `
                    <li class="page-item ${current === totalPages ? 'disabled' : ''}">
                        <a class="page-link" href="#" data-page="${Math.min(totalPages, current+1)}" aria-label="Next"><span aria-hidden="true">›</span></a>
                    </li>
                    <li class="page-item ${current === totalPages ? 'disabled' : ''}">
                        <a class="page-link" href="#" data-page="${totalPages}" aria-label="Last"><span aria-hidden="true">»</span></a>
                    </li>`;

                document.getElementById('pagination').innerHTML = paginationHtml;
            }

            // تابع اصلی برای fetch صفحه (با ابورت و مدیریت race)
            async function fetchPage(pageNumber) {
                // محافظت در برابر صفحات نامعتبر
                pageNumber = Math.max(1, Math.min(pageNumber, state.totalPages || 1));

                // ابورت درخواست قبلی
                if (currentController) {
                    try { currentController.abort(); } catch (e) {}
                }
                currentController = new AbortController();
                const thisRequestId = ++currentRequestId;

                showLoading();
                const request = buildRequest(pageNumber);
                console.log('Fetching page', pageNumber, 'requestId', thisRequestId, request);

                try {
                    const res = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify(request),
                        signal: currentController.signal
                    });

                    if (!res.ok) {
                        throw new Error(`HTTP ${res.status}`);
                    }

                    const data = await res.json();
                    // اگر این پاسخ قدیمی است نادیده بگیر
                    if (thisRequestId !== currentRequestId) {
                        console.warn('Stale response ignored for requestId', thisRequestId);
                        return;
                    }

                    // به‌روزرسانی state (با fallback)
                    state.pageNumber = data.pageNumber ?? pageNumber;
                    state.totalRecords = data.totalRecords ?? 0;
                    state.totalPages = data.totalPages ?? 1;
                    state.pageSize = data.pageSize ?? state.pageSize;

                    renderProducts(data.data ?? []);
                    renderPagination();
                    // اسکرول به بالا
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                } catch (err) {
                    if (err.name === 'AbortError') {
                        console.info('Fetch aborted for requestId', thisRequestId);
                        return;
                    }
                    console.error('Fetch error:', err);
                    grid.innerHTML = `
                        <div class="col-12">
                            <div class="alert alert-danger">
                                <h5>Error loading page ${pageNumber}</h5>
                                <p>${err.message}</p>
                                <button class="btn btn-sm btn-warning mt-2" id="goFirstBtn">Go to First Page</button>
                            </div>
                        </div>`;
                    document.getElementById('goFirstBtn')?.addEventListener('click', () => goToPage(1));
                } finally {
                    hideLoading();
                }
            }

            // wrapper تا با نام سابق سازگار باشد
            window.goToPage = function(pageNumber) {
                pageNumber = parseInt(pageNumber, 10) || 1;
                if (pageNumber < 1 || (state.totalPages && pageNumber > state.totalPages) || pageNumber === state.pageNumber) {
                    return;
                }
                state.pageNumber = pageNumber;
                fetchPage(pageNumber);
            };

            // delegation برای کلیک روی pagination links
            document.getElementById('pagination').addEventListener('click', function (e) {
                const a = e.target.closest('a.page-link');
                if (!a) return;
                e.preventDefault();
                const page = parseInt(a.getAttribute('data-page'), 10);
                if (!isNaN(page)) window.goToPage(page);
            });

            // هندلر جستجو
            document.getElementById('searchBtn').addEventListener('click', function () {
                state.pageNumber = 1;
                fetchPage(1);
            });
            document.getElementById('searchInput').addEventListener('keypress', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    state.pageNumber = 1;
                    fetchPage(1);
                }
            });

            // هندلر حذف - delegation
            document.addEventListener('click', function (e) {
                const deleteBtn = e.target.closest('.delete-product');
                if (!deleteBtn) return;
                const productId = deleteBtn.dataset.id;
                if (!confirm('Are you sure you want to delete this product?')) return;

                // ذخیرهٔ متن قبلی دکمه برای بازگشت
                const originalHtml = deleteBtn.innerHTML;
                deleteBtn.dataset._orig = originalHtml;
                deleteBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Deleting...';
                deleteBtn.disabled = true;

                const tokenEl = document.getElementById('__RequestVerificationToken');
                const token = tokenEl ? tokenEl.value : '';

                fetch(`?handler=Delete&id=${productId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token,
                        'Content-Type': 'application/x-www-form-urlencoded',
                    }
                })
                .then(r => {
                    if (!r.ok) throw new Error(`HTTP ${r.status}`);
                    return r.json();
                })
                .then(data => {
                    if (data.success) {
                        showSuccessMessage('Product deleted successfully!');
                        // رفرش صفحه جاری بعد از حذف
                        setTimeout(() => fetchPage(state.pageNumber), 700);
                    } else {
                        throw new Error(data.message || 'Delete failed');
                    }
                })
                .catch(err => {
                    console.error('Delete error:', err);
                    alert('Failed to delete product: ' + err.message);
                    // بازگرداندن دکمه به حالت اول
                    deleteBtn.innerHTML = deleteBtn.dataset._orig || 'Remove';
                    deleteBtn.disabled = false;
                });
            });

            // پیام موفقیت
            function showSuccessMessage(message) {
                document.querySelectorAll('.alert-success').forEach(a => a.remove());
                const alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-success alert-dismissible fade show position-fixed top-0 end-0 m-3';
                alertDiv.style.zIndex = '1050';
                alertDiv.innerHTML = `<strong>Success!</strong> ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
                document.body.appendChild(alertDiv);
                setTimeout(() => alertDiv.remove(), 3000);
            }

            // اولیه‌سازی
            console.log('Initial state:', state);
            renderPagination();

            // اگر می‌خواهید لود اولیه هم از API بیاید، این را فعال کنید:
            // fetchPage(state.pageNumber);

        })();
    </script>
}
