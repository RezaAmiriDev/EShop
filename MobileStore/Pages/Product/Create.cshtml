@page
@model EShope.Pages.Product.CreateModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "ایجاد محصول";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">ایجاد محصول جدید</h5>
                </div>

                <div class="card-body">
                    <form method="post" enctype="multipart/form-data" class="needs-validation" novalidate>

                        <!-- Brand -->
                        <div class="mb-3">
                            <label asp-for="dto.Brand" class="form-label fw-semibold">برند</label>
                            <input asp-for="dto.Brand" class="form-control" placeholder="مثال: Samsung" />
                            <span asp-validation-for="dto.Brand" class="text-danger small"></span>
                        </div>

                        <!-- Type & Price -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="dto.Type" class="form-label fw-semibold">نوع محصول</label>
                                <select asp-for="dto.Type"
                                        class="form-select"
                                        asp-items="Html.GetEnumSelectList<ProductType>()">
                                    <option value="">انتخاب کنید</option>
                                </select>
                                <span asp-validation-for="dto.Type" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="dto.Price" class="form-label fw-semibold">قیمت</label>
                                <div class="input-group">
                                    <input asp-for="dto.Price" class="form-control" placeholder="0" />
                                    <span class="input-group-text">تومان</span>
                                </div>
                                <span asp-validation-for="dto.Price" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Image -->
                        <div class="mb-3">
                            <label asp-for="dto.ImageFile" class="form-label fw-semibold">تصویر محصول</label>
                            <input asp-for="dto.ImageFile"
                                   type="file"
                                   class="form-control"
                                   accept="image/*"
                                   onchange="previewImage(this)" />
                            <span asp-validation-for="dto.ImageFile" class="text-danger small"></span>
                        </div>

                        <!-- Image Preview -->
                        <div class="mb-3 text-center">
                            <img id="imagePreview"
                                 src="/images/no-image.png"
                                 class="img-thumbnail d-none"
                                 style="max-height: 200px;" />
                        </div>

                        <!-- Actions -->
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-page="/Product/Index" class="btn btn-outline-secondary">
                                انصراف
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                ذخیره محصول
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function previewImage(input) {
            const preview = document.getElementById('imagePreview');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                };
                reader.readAsDataURL(input.files[0]);
            } else {
                preview.classList.add('d-none');
                preview.src = '';
            }
        }
    </script>
}
