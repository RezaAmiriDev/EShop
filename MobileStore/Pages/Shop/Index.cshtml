@page
@model EShope.Pages.Shop.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<style>
    .avatar {
        width: 84px;
        height: 84px;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid #fff;
        box-shadow: 0 6px 14px rgba(0,0,0,0.08);
    }

    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 100%;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

    .card-body {
        display: flex;
        flex-direction: column;
    }

    .btn-like, .btn-dislike {
        min-width: 80px;
    }
</style>

<!-- محل نمایش لیست فروشگاه‌ها (Partial) -->
<div id="shopListContainer">
    @await Html.PartialAsync("_ShopList", Model)
</div>

<!-- Modal جزئیات -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-shop me-2"></i>
                    Store Detail
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <!-- Loading -->
                <div id="loadingSpinner" class="text-center py-5">
                    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                        <span class="visually-hidden">در حال بارگذاری...</span>
                    </div>
                    <p class="mt-3 text-muted">در حال دریافت اطلاعات فروشگاه...</p>
                </div>

                <!-- Error -->
                <div id="errorMessage" class="alert alert-danger text-center" style="display: none;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <span id="errorText">خطا در دریافت اطلاعات</span>
                </div>

                <!-- Content -->
                <div id="shopDetails" style="display: none;">
                    <!-- اینجا با JavaScript پر می‌شود -->
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
                <a id="editShopLink" href="#" class="btn btn-primary">
                    <i class="bi bi-pencil-square me-1"></i>
                    ویرایش فروشگاه
                </a>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        const apiBaseUrl = '@Model.ApiBaseUrl';

        // ======================== توابع کمکی ========================
        function showLoader() {
            let loader = document.getElementById('loaderOverlay');
            if (!loader) {
                loader = document.createElement('div');
                loader.id = 'loaderOverlay';
                loader.style.cssText = 'position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9999; display:flex; align-items:center; justify-content:center;';
                loader.innerHTML = '<div class="spinner-border text-light" style="width:4rem;height:4rem;"></div>';
                document.body.appendChild(loader);
            }
            loader.style.display = 'flex';
        }

        function hideLoader() {
            let loader = document.getElementById('loaderOverlay');
            if (loader) loader.style.display = 'none';
        }

        // بارگذاری مجدد بخش فروشگاه‌ها (کارت‌ها + صفحه‌بندی)
        async function reloadShopList(pageNumber) {
            showLoader();

            let searchTerm = document.querySelector('input[name="SearchTerm"]').value;
            let pageSize = @Model.PageSize;
            let url = `?pageNumber=${pageNumber}&pageSize=${pageSize}&SearchTerm=${encodeURIComponent(searchTerm)}`;

            try {
                const response = await fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const html = await response.text();
                document.getElementById('shopListContainer').innerHTML = html;
                // پس از به‌روزرسانی، پیام موفقیت/خطا (TempData) ممکن است تغییر کند - نیازی به دستکاری اضافی نیست
            } catch (error) {
                console.error('Error loading shops:', error);
                showToast('error', 'خطا در بارگذاری فروشگاه‌ها');
            } finally {
                hideLoader();
            }
        }

        // تابع صفحه‌بندی (که از لینک‌ها صدا زده می‌شود)
        window.GoToPage = function(pageNumber) {
            reloadShopList(pageNumber);
        };

        // ======================== نمایش جزئیات فروشگاه (بدون تغییر) ========================
        async function showShopDetails(shopId) {
            const modal = new bootstrap.Modal('#detailModal');
            const loading = document.getElementById('loadingSpinner');
            const error = document.getElementById('errorMessage');
            const content = document.getElementById('shopDetails');

            loading.style.display = 'block';
            error.style.display = 'none';
            content.style.display = 'none';
            content.innerHTML = '';

            try {
                modal.show();
                const response = await fetch(`?handler=Details&id=${shopId}`);
                if (response.ok) {
                    const shop = await response.json();
                    let imageUrl;
                    if (!shop.imagePath || shop.imagePath.toLowerCase() === 'null') {
                        imageUrl = '/images/default-avatar.jpg';
                    } else {
                        imageUrl = '@Model.ApiBaseUrl' + shop.imagePath;
                    }
                    const html = `
                        <div class="row">
                            <div class="col-md-4 text-center mb-3 mb-md-0">
                                <img src="${imageUrl}"
                                     class="img-fluid rounded-circle border"
                                     style="width: 150px; height: 150px; object-fit: cover;"
                                     onerror="this.src='/images/default-avatar.jpg'"
                                     alt="${shop.shopName || 'فروشگاه'}">
                            </div>
                            <div class="col-md-8">
                                <h4 class="mb-1">${shop.shopName || 'بدون نام'}</h4>
                                ${shop.shopCode ? `<p class="text-muted mb-3"><strong>store code :</strong> ${shop.shopCode}</p>` : ''}
                                <div class="mb-4">
                                    <h6 class="text-secondary"><strong>discreption : </strong></h6>
                                    <p class="text-muted">${shop.description || 'توضیحاتی ثبت نشده است.'}</p>
                                </div>
                                <div class="row">
                                    <div class="col-6 col-md-3 mb-3">
                                        <div class="card bg-light border-0">
                                            <div class="card-body text-center py-3">
                                                <div class="h4 mb-0">${shop.numberOfproducts || 0}</div>
                                                <small class="text-muted">محصول</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3 mb-3">
                                        <div class="card bg-light border-0">
                                            <div class="card-body text-center py-3">
                                                <div class="h4 mb-0 text-success">${shop.likesCount || 0}</div>
                                                <small class="text-muted">لایک</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3 mb-3">
                                        <div class="card bg-light border-0">
                                            <div class="card-body text-center py-3">
                                                <div class="h4 mb-0 text-danger">${shop.dislikesCount || 0}</div>
                                                <small class="text-muted">دیسلایک</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    content.innerHTML = html;
                    loading.style.display = 'none';
                    content.style.display = 'block';
                    document.getElementById('editShopLink').href = `/Shop/Update?id=${shopId}`;
                } else if (response.status === 401) {
                    window.location.href = '@Model.Setting?.LoginPath' || '/Account/Login';
                } else {
                    throw new Error('خطا در دریافت اطلاعات');
                }
            } catch (err) {
                console.error('Error:', err);
                loading.style.display = 'none';
                error.style.display = 'block';
                document.getElementById('errorText').textContent = 'خطا در دریافت اطلاعات فروشگاه. لطفاً دوباره تلاش کنید.';
            }
        }

        // ======================== لایک و دیسلایک (بدون تغییر) ========================
        async function likeShop(shopId, button) {
            const likeCount = button.querySelector('.like-count');
            try {
                const response = await fetch(`?handler=Like&id=${shopId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                if (response.ok) {
                    const result = await response.json();
                    likeCount.textContent = result.newLikesCount || 0;
                    showToast('success', 'لایک ثبت شد');
                }
            } catch (error) {
                console.error('Error liking shop:', error);
                showToast('error', 'خطا در ثبت لایک');
            }
        }

        async function dislikeShop(shopId, button) {
            const dislikeCount = button.querySelector('.dislike-count');
            try {
                const response = await fetch(`?handler=Dislike&id=${shopId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                if (response.ok) {
                    const result = await response.json();
                    dislikeCount.textContent = result.newDislikesCount || 0;
                    showToast('success', 'دیسلایک ثبت شد');
                }
            } catch (error) {
                console.error('Error disliking shop:', error);
                showToast('error', 'خطا در ثبت دیسلایک');
            }
        }

        // ======================== Toast (بدون تغییر) ========================
        function showToast(type, message) {
            if (typeof bootstrap === 'undefined' || !bootstrap.Toast) {
                alert(message);
                return;
            }
            const toastHtml = `
                <div class="toast align-items-center text-bg-${type} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="bi ${type === 'success' ? 'bi-check-circle' : 'bi-exclamation-circle'} me-2"></i>
                            ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;
            const container = document.getElementById('toastContainer') || createToastContainer();
            container.innerHTML = toastHtml;
            const toastEl = container.querySelector('.toast');
            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }

        function createToastContainer() {
            const container = document.createElement('div');
            container.id = 'toastContainer';
            container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
            document.body.appendChild(container);
            return container;
        }

        // ======================== مدیریت فرم جستجو ========================
        document.addEventListener('DOMContentLoaded', function() {
            // پیام موقت (messageBox) بعد از 3 ثانیه محو شود
            const msg = document.getElementById("messageBox");
            if (msg) {
                setTimeout(() => {
                    msg.classList.remove("show");
                    msg.classList.add("fade");
                    setTimeout(() => msg.remove(), 400);
                }, 3000);
            }

            // جلوگیری از ارسال سنتی فرم جستجو و بارگذاری AJAX
            const searchForm = document.querySelector('form[method="get"]');
            if (searchForm) {
                searchForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    await reloadShopList(1);
                });
            }

            console.log('Shop page loaded. API Base URL:', apiBaseUrl);
        });
    </script>
}